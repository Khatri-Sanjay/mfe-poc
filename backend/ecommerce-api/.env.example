NODE_ENV=development
PORT=3000
LOG_LEVEL=info

DATABASE_URL=postgresql://ecommerce:ecommerce_password@localhost:5433/ecommerce_api
TEST_DATABASE_URL=postgresql://ecommerce:ecommerce_password@localhost:5433/ecommerce_api_test
DATABASE_SSL=false

CORS_ORIGINS=http://localhost:4200,http://localhost:4201,http://localhost:4202,http://localhost:4203,http://localhost:4204,http://localhost:4205

JWT_ACCESS_SECRET=replace-with-at-least-32-characters-for-development
JWT_ACCESS_EXPIRES_IN=15m
REFRESH_TOKEN_EXPIRES_IN=30d

PASSWORD_RESET_TOKEN_TTL=15m
EMAIL_VERIFICATION_TOKEN_TTL=24h

PAYMENT_PROVIDER=mock

THROTTLE_TTL=60000
THROTTLE_LIMIT=100

DEV_ADMIN_EMAIL=admin@example.com
DEV_ADMIN_PASSWORD=replace-with-a-long-development-password
